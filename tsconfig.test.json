{
  "compilerOptions": {
    "target": "ES2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "outDir": ".test-build",
    "rootDir": "src/lib",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": false,
    "types": [
      "node"
    ]
  },
  "include": [
    "src/lib/ai-transport.ts",
    "src/lib/ssrf.ts",
    "src/lib/zip.ts",
    "src/lib/scaffold.ts",
    "src/lib/deflate.ts",
    "src/lib/forge-schema.ts",
    "src/lib/forge-render.ts",
    "src/lib/preview.ts",
    "src/lib/forge-geometry.ts",
    "src/lib/forge-scene.ts"
  ]
}
